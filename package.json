  "scripts": {
    "gen:icon": "node scripts/gen-icon.mjs",
    "gen:contributes": "node scripts/gen-contributes.mjs",
    "check:contributes": "node scripts/gen-contributes.mjs --check",
    "gen:l10n": "node scripts/gen-l10n.mjs",
    "check:l10n": "node scripts/gen-l10n.mjs --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:performance": "vitest run --config vitest.perf.config.ts",
    "build": "node esbuild.mjs --production",
    "watch": "node esbuild.mjs --watch",
    "package": "node scripts/package.mjs",
    "vscode:prepublish": "npm run build"
  },
  "dependencies": {
    "@csstools/css-color-parser": "4.1.10",
    "@csstools/css-parser-algorithms": "4.0.0",
    "@csstools/css-tokenizer": "4.0.0",
    "colorjs.io": "0.7.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/vscode": "^1.101.0",
    "@vscode/vsce": "^3.2.2",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
