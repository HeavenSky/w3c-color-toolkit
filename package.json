{
  "name": "w3c-color-toolkit",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "version": "0.0.2",
  "license": "MIT",
  "publisher": "HeavenSky",
  "repository": {
    "type": "git",
    "url": "https://github.com/HeavenSky/w3c-color-toolkit"
  },
  "homepage": "https://github.com/HeavenSky/w3c-color-toolkit",
  "bugs": {
    "url": "https://github.com/HeavenSky/w3c-color-toolkit/issues"
  },
  "icon": "media/icon.png",
  "categories": [
    "Programming Languages",
    "Visualization",
    "Other"
  ],
  "keywords": [
    "color",
    "css",
    "highlight",
    "hover",
    "convert"
  ],
  "engines": {
    "vscode": "^1.101.0",
    "node": ">=20.19.0"
  },
  "main": "./dist/extension-node.js",
  "browser": "./dist/extension-web.js",
  "l10n": "./l10n",
  "extensionKind": [
    "workspace",
    "ui"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "%capabilities.untrustedWorkspaces%"
    }
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "configuration": {
      "title": "%extension.displayName%",
      "properties": {
        "w3cColorToolkit.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%config.enabled%",
          "scope": "resource"
        },
        "w3cColorToolkit.languages": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "*"
          ],
          "description": "%config.languages%",
          "scope": "resource"
        },
        "w3cColorToolkit.highlight": {
          "type": "string",
          "enum": [
            "off",
            "background",
            "foreground",
            "outline",
            "underline",
            "dot-before",
            "dot-after",
            "square-before",
            "square-after"
          ],
          "default": "underline",
          "description": "%config.highlight%",
          "scope": "resource"
        },
        "w3cColorToolkit.info": {
          "type": "boolean",
          "default": true,
          "description": "%config.info%",
          "scope": "resource"
        },
        "w3cColorToolkit.convertSyntax": {
          "type": "string",
          "enum": [
            "modern",
            "legacy"
          ],
          "default": "legacy",
          "description": "%config.convertSyntax%",
          "scope": "resource"
        },
        "w3cColorToolkit.precision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "default": 5,
          "description": "%config.precision%",
          "scope": "resource"
        },
        "w3cColorToolkit.experimental": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "cssColor6",
              "cssColorHdr"
            ]
          },
          "default": [
            "cssColor6",
            "cssColorHdr"
          ],
          "description": "%config.experimental%",
          "scope": "resource"
        },
        "w3cColorToolkit.advanced": {
          "type": "object",
          "scope": "resource",
          "default": {},
          "additionalProperties": false,
          "properties": {
            "highlight.markRuler": {
              "type": "boolean",
              "default": true,
              "description": "%advanced.highlight.markRuler%"
            },
            "highlight.matchWords": {
              "type": "string",
              "enum": [
                "off",
                "css-like",
                "all"
              ],
              "default": "css-like",
              "description": "%advanced.highlight.matchWords%"
            },
            "highlight.hexAlphaOrder": {
              "type": "string",
              "enum": [
                "rgba",
                "argb"
              ],
              "default": "rgba",
              "description": "%advanced.highlight.hexAlphaOrder%"
            },
            "highlight.matchRgbWithoutFunction": {
              "type": "boolean",
              "default": false,
              "description": "%advanced.highlight.matchRgbWithoutFunction%"
            },
            "highlight.rgbWithoutFunctionLanguages": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": [
                "*"
              ],
              "description": "%advanced.highlight.rgbWithoutFunctionLanguages%"
            },
            "highlight.matchHslWithoutFunction": {
              "type": "boolean",
              "default": false,
              "description": "%advanced.highlight.matchHslWithoutFunction%"
            },
            "highlight.hslWithoutFunctionLanguages": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": [
                "*"
              ],
              "description": "%advanced.highlight.hslWithoutFunctionLanguages%"
            },
            "highlight.maxMatchesPerDocument": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000,
              "default": 10000,
              "description": "%advanced.highlight.maxMatchesPerDocument%"
            },
            "highlight.hdrToneMapping": {
              "type": "string",
              "enum": [
                "none",
                "reinhard",
                "clip"
              ],
              "default": "reinhard",
              "description": "%advanced.highlight.hdrToneMapping%"
            },
            "colorPicker.mode": {
              "type": "string",
              "enum": [
                "off",
                "dedupe",
                "all"
              ],
              "default": "dedupe",
              "description": "%advanced.colorPicker.mode%"
            },
            "fields.enabled": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "string"
              },
              "default": null,
              "description": "%advanced.fields.enabled%"
            },
            "fields.excluded": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": [],
              "description": "%advanced.fields.excluded%"
            },
            "info.previewSize": {
              "type": "string",
              "enum": [
                "small",
                "large"
              ],
              "default": "small",
              "description": "%advanced.info.previewSize%"
            },
            "info.previewShape": {
              "type": "string",
              "enum": [
                "square",
                "rectangle"
              ],
              "default": "rectangle",
              "description": "%advanced.info.previewShape%"
            },
            "info.showDiagnostics": {
              "type": "boolean",
              "default": true,
              "description": "%advanced.info.showDiagnostics%"
            },
            "info.showSpecLevel": {
              "type": "boolean",
              "default": true,
              "description": "%advanced.info.showSpecLevel%"
            },
            "convert.enabled": {
              "type": "boolean",
              "default": true,
              "description": "%advanced.convert.enabled%"
            },
            "convert.alphaLoss": {
              "type": "string",
              "enum": [
                "reject",
                "confirm",
                "drop"
              ],
              "default": "reject",
              "description": "%advanced.convert.alphaLoss%"
            },
            "convert.missingComponentLoss": {
              "type": "string",
              "enum": [
                "confirm",
                "compute"
              ],
              "default": "confirm",
              "description": "%advanced.convert.missingComponentLoss%"
            },
            "convert.namedColorFallback": {
              "type": "string",
              "enum": [
                "reject",
                "nearest"
              ],
              "default": "reject",
              "description": "%advanced.convert.namedColorFallback%"
            },
            "convert.recentFirst": {
              "type": "boolean",
              "default": true,
              "description": "%advanced.convert.recentFirst%"
            },
            "output.gamutMapping": {
              "type": "string",
              "enum": [
                "css",
                "clip",
                "none"
              ],
              "default": "css",
              "description": "%advanced.output.gamutMapping%"
            },
            "output.hexCase": {
              "type": "string",
              "enum": [
                "lower",
                "upper"
              ],
              "default": "lower",
              "description": "%advanced.output.hexCase%"
            },
            "scan.comments": {
              "type": "boolean",
              "default": true,
              "description": "%advanced.scan.comments%"
            },
            "scan.strings": {
              "type": "boolean",
              "default": true,
              "description": "%advanced.scan.strings%"
            },
            "scan.maxDocumentSizeKb": {
              "type": "integer",
              "minimum": 1,
              "maximum": 102400,
              "default": 2048,
              "description": "%advanced.scan.maxDocumentSizeKb%"
            },
            "contextualPreview": {
              "type": "string",
              "enum": [
                "off",
                "auto",
                "light",
                "dark"
              ],
              "default": "auto",
              "description": "%advanced.contextualPreview%"
            },
            "variables.resolve": {
              "type": "boolean",
              "default": true,
              "description": "%advanced.variables.resolve%"
            },
            "variables.includePaths": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": [],
              "description": "%advanced.variables.includePaths%"
            },
            "variables.maxImportDepth": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100,
              "default": 20,
              "description": "%advanced.variables.maxImportDepth%"
            },
            "variables.maxImportFiles": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000,
              "default": 200,
              "description": "%advanced.variables.maxImportFiles%"
            },
            "variables.maxResolveDepth": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20,
              "description": "%advanced.variables.maxResolveDepth%"
            },
            "experimental.hdrAssumedHeadroom": {
              "type": "number",
              "minimum": 0,
              "maximum": 10,
              "default": 0,
              "description": "%advanced.experimental.hdrAssumedHeadroom%"
            },
            "coexistence.notify": {
              "type": "boolean",
              "default": true,
              "description": "%advanced.coexistence.notify%"
            },
            "logLevel": {
              "type": "string",
              "enum": [
                "off",
                "error",
                "warn",
                "info",
                "debug"
              ],
              "default": "warn",
              "description": "%advanced.logLevel%"
            }
          },
          "markdownDescription": "%config.advanced%",
          "defaultSnippets": [
            {
              "label": "All advanced options (with defaults)",
              "description": "Insert all 35 built-in options with their default values",
              "body": {
                "highlight.markRuler": true,
                "highlight.matchWords": "css-like",
                "highlight.hexAlphaOrder": "rgba",
                "highlight.matchRgbWithoutFunction": false,
                "highlight.rgbWithoutFunctionLanguages": [
                  "*"
                ],
                "highlight.matchHslWithoutFunction": false,
                "highlight.hslWithoutFunctionLanguages": [
                  "*"
                ],
                "highlight.maxMatchesPerDocument": 10000,
                "highlight.hdrToneMapping": "reinhard",
                "colorPicker.mode": "dedupe",
                "fields.enabled": null,
                "fields.excluded": [],
                "info.previewSize": "small",
                "info.previewShape": "rectangle",
                "info.showDiagnostics": true,
                "info.showSpecLevel": true,
                "convert.enabled": true,
                "convert.alphaLoss": "reject",
                "convert.missingComponentLoss": "confirm",
                "convert.namedColorFallback": "reject",
                "convert.recentFirst": true,
                "output.gamutMapping": "css",
                "output.hexCase": "lower",
                "scan.comments": true,
                "scan.strings": true,
                "scan.maxDocumentSizeKb": 2048,
                "contextualPreview": "auto",
                "variables.resolve": true,
                "variables.includePaths": [],
                "variables.maxImportDepth": 20,
                "variables.maxImportFiles": 200,
                "variables.maxResolveDepth": 20,
                "experimental.hdrAssumedHeadroom": 0,
                "coexistence.notify": true,
                "logLevel": "warn"
              }
            },
            {
              "label": "Minimal example",
              "description": "A few commonly changed options",
              "body": {
                "output.hexCase": "upper",
                "highlight.matchWords": "all",
                "scan.comments": false
              }
            }
          ]
        }
      }
    },
    "configurationDefaults": {
      "editor.defaultColorDecorators": "never"
    },
    "commands": [
      {
        "command": "w3cColorToolkit.convert",
        "title": "%command.convert%",
        "category": "%command.category%"
      },
      {
        "command": "w3cColorToolkit.copyColorAs",
        "title": "%command.copyColorAs%",
        "category": "%command.category%"
      },
      {
        "command": "w3cColorToolkit.toggleFeatures",
        "title": "%command.toggleFeatures%",
        "category": "%command.category%"
      },
      {
        "command": "w3cColorToolkit.configureColorFields",
        "title": "%command.configureColorFields%",
        "category": "%command.category%"
      },
      {
        "command": "w3cColorToolkit.manage",
        "title": "%command.manage%",
        "category": "%command.category%"
      },
      {
        "command": "w3cColorToolkit.convertTo.hex",
        "title": "%command.convertTo.hex%",
        "category": "%command.category%"
