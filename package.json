      {
        "command": "w3cColorToolkit.convertTo.lab",
        "title": "%command.convertTo.lab%",
        "category": "%command.category%"
      },
      {
        "command": "w3cColorToolkit.convertTo.lch",
        "title": "%command.convertTo.lch%",
        "category": "%command.category%"
      },
      {
        "command": "w3cColorToolkit.convertTo.oklab",
        "title": "%command.convertTo.oklab%",
        "category": "%command.category%"
      },
      {
        "command": "w3cColorToolkit.convertTo.srgb",
        "title": "%command.convertTo.srgb%",
        "category": "%command.category%"
      },
      {
        "command": "w3cColorToolkit.convertTo.srgbLinear",
        "title": "%command.convertTo.srgbLinear%",
        "category": "%command.category%"
      },
      {
        "command": "w3cColorToolkit.convertTo.displayP3",
        "title": "%command.convertTo.displayP3%",
        "category": "%command.category%"
      },
      {
        "command": "w3cColorToolkit.convertTo.displayP3Linear",
        "title": "%command.convertTo.displayP3Linear%",
