    "submenus": [
      {
        "id": "w3cColorToolkit.editorContext",
        "label": "%extension.displayName%"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "w3cColorToolkit.convert",
          "when": "editorIsOpen"
        },
        {
          "command": "w3cColorToolkit.copyColorAs",
          "when": "editorIsOpen"
        },
        {
          "command": "w3cColorToolkit.convertTo.hex",
          "when": "false"
        },
        {
