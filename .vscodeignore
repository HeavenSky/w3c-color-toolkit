# 只保留运行时需要的内容; scripts/package.mjs 会按允许清单断言最终 VSIX 的完整内容。
.vscode/**
.github/**
.ai-ctx/**
.nvmrc
docs/**
src/**
test/**
scripts/**
node_modules/**
artifacts/**
vendor/**
media/icon.svg
build.mjs
tsconfig.json
vitest.config.ts
vitest.perf.config.ts
package-lock.json
.gitignore
.template-shared
**/*.ts
**/*.map
*.vsix

# 显式保留 (取反规则必须写在最后)
!out/**/*.js
!l10n/**
!media/icon.png
!package.nls.json
!package.nls.zh-cn.json
!LICENSE.txt
!NOTICE.md
!README.md
!README.zh-cn.md
!CHANGELOG.md
